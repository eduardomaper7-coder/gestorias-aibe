# Copie este fichero como ".env" y rellene los valores.
# NUNCA suba el fichero .env a Git ni lo comparta: contiene claves.
# Para generar claves seguras:  docker compose run --rm api python -m app.cli generar-claves

ENTORNO=desarrollo

# --- Base de datos (Docker Compose construye las direcciones con estas contraseñas)
POSTGRES_PASSWORD=cambia-esto
POSTGRES_APP_PASSWORD=cambia-esto-tambien

# --- Seguridad
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# 32 bytes en base64. Si se pierde, las contraseñas de buzones guardadas no se podrán leer.
CLAVE_MAESTRA_CIFRADO=
# En local puede ponerse a false para probar más cómodo. En producción SIEMPRE true.
EXIGIR_2FA_ADMIN=false
# En producción (con HTTPS) true
COOKIES_SEGURAS=false

# --- IA (Claude, API de Anthropic)
# "falso" = respuestas simuladas, sin coste. "claude" = API real (necesita la clave).
PROVEEDOR_LLM=falso
ANTHROPIC_API_KEY=
MODELO_BARATO=claude-haiku-5-5
MODELO_REDACCION=claude-sonnet-5-5
CAMBIO_USD_EUR=0.92
PRESUPUESTO_IA_MENSUAL_EUR_DEFECTO=60
